# Copy this file to `.env` and fill in the values. Every setting is optional for local development.

# The live site address (no trailing slash). Used for canonical URLs, Open Graph tags and the sitemap.
VITE_SITE_URL=https://brand-gap.vercel.app

# Analytics — leave empty until the IDs exist. Nothing loads until an ID is set AND the
# visitor accepts the cookie banner.
VITE_GA4_ID=
VITE_META_PIXEL_ID=
VITE_CLARITY_ID=

# Form delivery: Web3Forms access key (https://web3forms.com). Every form arrives as an email.
VITE_WEB3FORMS_KEY=ac31b0df-c082-4aa2-abe1-50e776bc112b

# Optional alternative: a webhook that receives submissions as JSON. Ignored while
# VITE_WEB3FORMS_KEY is set.
VITE_LEADS_ENDPOINT=
